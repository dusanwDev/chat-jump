{
  "manifest_version": 3,
  "name": "ChatGPT Quick Switch",
  "version": "1.0.0",
  "description": "Navigate faster between questions and answers in ChatGPT with arrow buttons",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
